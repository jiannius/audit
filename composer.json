{
    "name": "jiannius/audit",
    "description": "A small, generic audit trail for Laravel 13: append-only, strict-mode safe, fail-closed.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "TJ",
            "email": "tj@jiannius.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-tokenizer": "*",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jiannius\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannius\\Audit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jiannius\\Audit\\AuditServiceProvider"
            ],
            "aliases": {
                "Auditor": "Jiannius\\Audit\\Facades\\Auditor"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
